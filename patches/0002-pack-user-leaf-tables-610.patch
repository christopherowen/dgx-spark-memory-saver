+static NV_STATUS phys_mem_allocate_sysmem(uvm_page_tree_t *tree,
+                                         NvLength size,
+                                         uvm_mmu_page_table_alloc_t *out)
+{
+    struct uvm_mmu_sysmem_pool_page *pool;
+    unsigned long slot;
+    NV_STATUS status;
+    void *cpu;
+
+    // Pack only 256-byte user tables on 64 KiB pages, on a coherent integrated
+    // PCI GPU without vidmem. Everything else takes the full-page path.
+    if (!uvm_pack_sysmem_leaf_tables || PAGE_SIZE != 65536 || size != 256 ||
+        tree->type != UVM_PAGE_TREE_TYPE_USER || !tree->gpu->parent->pci_dev ||
+        !tree->gpu->parent->is_integrated_gpu || tree->gpu->mem_info.size ||
+        !dev_is_dma_coherent(&tree->gpu->parent->pci_dev->dev))
+        return phys_mem_allocate_sysmem_full_page(tree, size, out);
+
+    spin_lock(&tree->sysmem_pool_lock);
+    if (!list_empty(&tree->sysmem_pool_available)) {
+        pool = list_first_entry(&tree->sysmem_pool_available,
+                                struct uvm_mmu_sysmem_pool_page, available);
+        slot = find_first_zero_bit(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT);
+        UVM_ASSERT(slot < UVM_SYSMEM_TABLE_SLOT_COUNT);
+        __set_bit(slot, &pool->used);
+        if (bitmap_full(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT))
+            list_del_init(&pool->available);
+        spin_unlock(&tree->sysmem_pool_lock);
+    }
+    else {
+        spin_unlock(&tree->sysmem_pool_lock);
+        pool = kzalloc(sizeof(*pool), NV_UVM_GFP_FLAGS);
+        if (!pool)
+            return NV_ERR_NO_MEMORY;
+
+        // The full-page path supplies the memcg charge, DMA mapping, physical
+        // TLB invalidation and mapped_cpu_pages_size accounting for all slots.
+        status = phys_mem_allocate_sysmem_full_page(tree, PAGE_SIZE, &pool->backing);
+        if (status != NV_OK) {
+            kfree(pool);
+            return status;
+        }
+        INIT_LIST_HEAD(&pool->available);
+        slot = 0;
+        __set_bit(slot, &pool->used);
+        spin_lock(&tree->sysmem_pool_lock);
+        list_add(&pool->available, &tree->sysmem_pool_available);
+        spin_unlock(&tree->sysmem_pool_lock);
+    }
+
+    *out = pool->backing;
+    out->size = size;
+    out->sysmem_pool_page = pool;
+    out->addr.address += slot * UVM_SYSMEM_TABLE_SLOT_SIZE;
+    // Slots never share a cache line and DMA is coherent: no flush after zeroing.
+    cpu = kmap(out->handle.page);
+    memset((char *)cpu + slot * UVM_SYSMEM_TABLE_SLOT_SIZE, 0, UVM_SYSMEM_TABLE_SLOT_SIZE);
+    kunmap(out->handle.page);
+    return NV_OK;
+}
